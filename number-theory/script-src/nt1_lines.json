   },
   {
    "t0": 61.8,
    "t1": 65.65,
    "text": "先拿出落单的1个，放在角上，",
    "say": "先拿出落单的一个，放在角上，"
   },
   {
    "t0": 65.95,
    "t1": 71.2,
    "text": "剩下98个，分成两条胳膊，每条49个。",
    "say": "剩下九十八个，分成两条胳膊，每条四十九个。"
   },
   {
    "t0": 71.6,
    "t1": 75.45,
