   },
   {
    "t0": 4.55,
    "t1": 8.6,
    "text": "从1个点开始，一层一层往外包。",
    "say": "从一个点开始，一层一层往外包。"
   },
   {
    "t0": 9.3,
    "t1": 12.35,
    "text": "1变成4，多了3个。",
    "say": "一变成四，多了三个。"
   },
   {
    "t0": 12.95,
    "t1": 16.0,
    "text": "4变成9，多了5个。",
    "say": "四变成九，多了五个。"
   },
   {
    "t0": 16.6,
    "t1": 19.85,
    "text": "9变成16，多了7个。",
    "say": "九变成十六，多了七个。"
   },
   {
    "t0": 20.55,
    "t1": 24.03,
    "text": "“3、5、7……都是奇数！”",
