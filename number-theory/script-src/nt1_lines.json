 "open": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.35,
    "text": "陶哲轩的故事讲完了。"
   },
   {
    "t0": 3.75,
    "t1": 7.6,
    "text": "那个爱问“为什么”的小问号，"
   },
   {
    "t0": 7.7,
    "t1": 11.15,
    "text": "跳到了Jasper的练习本上。"
   },
   {
    "t0": 11.85,
    "t1": 14.9,
    "text": "Jasper每天都在算题。"
   },
   {
    "t0": 15.3,
    "t1": 17.95,
    "text": "“算对了，然后呢？”",
    "voice": "qm",
    "say": "算对了，然后呢？"
   },
   {
    "t0": 18.35,
    "t1": 22.0,
    "text": "然后，就可以开始问问题了。"
   },
   {
    "t0": 22.9,
    "t1": 27.75,
    "text": "整数的这些问题，叫数论，像一张大地图。"
   },
   {
    "t0": 28.25,
    "t1": 30.95,
    "text": "地图上有两扇门："
   },
   {
    "t0": 31.25,
    "t1": 34.74,
    "text": "一扇看一个数是谁乘谁，"
   },
   {
    "t0": 35.04,
    "t1": 38.69,
    "text": "一扇看分组以后，还剩几个。"
   },
   {
    "t0": 39.39,
    "t1": 43.84,
    "text": "两扇门中间，是一级比一级难的问题："
   },
   {
    "t0": 44.14,
    "t1": 48.42,
    "text": "“有没有？怎么造？找得全吗？”",
    "voice": "qm",
    "say": "有没有？怎么造？找得全吗？"
   },
   {
    "t0": 48.62,
    "t1": 52.47,
    "text": "“为什么不可能？有无穷多个吗？”",
    "voice": "qm",
    "say": "为什么不可能？有无穷多个吗？"
   },
   {
    "t0": 53.07,
    "t1": 56.73,
    "text": "远处有雾。我们只问整数，"
   },
   {
    "t0": 56.93,
    "t1": 60.78,
    "text": "可整数会逼我们去找更大的家。"
   },
   {
    "t0": 61.08,
    "t1": 63.33,
    "text": "先走第一步。"
   }
  ],
  "dur": 63.8
 },
 "six": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.35,
    "text": "Jasper的本子上写着："
   },
   {
    "t0": 3.55,
    "t1": 6.35,
    "text": "16减9等于7。",
    "say": "十六减九等于七。"
   },
   {
    "t0": 6.75,
    "t1": 10.82,
    "text": "16是4乘4，9是3乘3。",
    "say": "十六是四乘四，九是三乘三。"
   },
   {
    "t0": 11.22,
    "t1": 14.87,
    "text": "4乘4，可以写成4的平方。",
    "say": "四乘四，可以写成四的平方。"
   },
   {
    "t0": 15.57,
    "t1": 20.33,
    "text": "4×4的点阵，拿掉3×3，剩下7个。",
    "say": "四乘四的点阵，拿掉三乘三，剩下七个。"
   },
   {
    "t0": 20.83,
    "t1": 24.28,
    "text": "所以，7是两个平方的差。",
    "say": "所以，七是两个平方的差。"
   },
   {
    "t0": 24.98,
    "t1": 28.65,
    "text": "“我给它画个小拐角，当记号。”",
    "voice": "kid",
    "say": "我给它画个小拐角，当记号。"
   },
   {
    "t0": 29.15,
    "t1": 33.4,
    "text": "“小拐角是什么意思？别人看得懂吗？”",
    "voice": "qm",
    "say": "小拐角是什么意思？别人看得懂吗？"
   },
   {
    "t0": 33.8,
    "t1": 38.68,
    "text": "“意思是：能写成一个平方减另一个平方。”",
    "voice": "kid",
    "say": "意思是：能写成一个平方减另一个平方。"
   },
   {
    "t0": 39.08,
    "t1": 41.73,
    "text": "“0的平方算不算？”",
    "voice": "qm",
    "say": "零的平方算不算？"
   },
   {
    "t0": 42.23,
    "t1": 45.89,
    "text": "好问题。规则得写清楚："
   },
   {
    "t0": 46.19,
    "t1": 51.72,
    "text": "两个数，都从0、1、2、3……里挑，",
    "say": "两个数，都从零、一、二、三……里挑，"
   },
   {
    "t0": 51.92,
    "t1": 56.37,
    "text": "前一个比后一个大，后一个可以是0。",
    "say": "前一个比后一个大，后一个可以是零。"
   },
   {
    "t0": 56.57,
    "t1": 60.02,
    "text": "比0还小的数，以后再说。",
    "say": "比零还小的数，以后再说。"
   },
   {
    "t0": 60.42,
    "t1": 64.07,
    "text": "写清楚了，别人才能照着用。"
   },
   {
    "t0": 64.97,
    "t1": 67.14,
    "text": "那6呢？",
    "say": "那六呢？"
   },
   {
    "t0": 67.54,
    "t1": 71.32,
    "text": "“9减3？3不是平方。”",
    "voice": "kid",
    "say": "九减三？三不是平方。"
   },
   {
    "t0": 71.72,
    "t1": 75.52,
    "text": "“16减10？10也不是。”",
    "voice": "kid",
    "say": "十六减十？十也不是。"
   },
   {
    "t0": 75.92,
    "t1": 78.64,
    "text": "“25减19……”",
    "voice": "kid",
    "say": "二十五减十九……"
   },
   {
    "t0": 79.24,
    "t1": 82.89,
    "text": "找了半天，6还没有小拐角。",
    "say": "找了半天，六还没有小拐角。"
   },
   {
    "t0": 83.39,
    "t1": 87.04,
    "text": "“是还没找到，还是根本没有？”",
    "voice": "qm",
    "say": "是还没找到，还是根本没有？"
   }
  ],
  "dur": 87.5
 },
 "bands": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 4.15,
    "text": "先别急着找6，看看能找到谁。",
    "say": "先别急着找六，看看能找到谁。"
   },
   {
    "t0": 4.55,
    "t1": 8.6,
    "text": "从1个点开始，一层一层往外包。",
    "say": "从一个点开始，一层一层往外包。"
   },
   {
    "t0": 9.3,
    "t1": 12.35,
    "text": "1变成4，多了3个。",
    "say": "一变成四，多了三个。"
   },
   {
    "t0": 12.95,
    "t1": 16.06,
    "text": "4变成9，多了5个。",
    "say": "四变成九，多了五个。"
   },
   {
    "t0": 16.66,
    "t1": 19.91,
    "text": "9变成16，多了7个。",
    "say": "九变成十六，多了七个。"
   },
   {
    "t0": 20.61,
    "t1": 24.73,
    "text": "“3、5、7……都是奇数！”",
    "voice": "kid",
    "say": "三、五、七……都是奇数！"
   },
   {
    "t0": 26.33,
    "t1": 30.76,
    "text": "“每一圈都是拐角，跟我的记号一个样！”",
    "voice": "kid",
    "say": "每一圈都是拐角，跟我的记号一个样！"
   },
   {
    "t0": 31.46,
    "t1": 34.93,
    "text": "可是，我们只看了三层。"
   },
   {
    "t0": 35.33,
    "t1": 38.58,
    "text": "“第一百层，也是奇数吗？”",
    "voice": "qm",
    "say": "第一百层，也是奇数吗？"
   }
  ],
  "dur": 39.1
 },
 "proof": {
  "subs": [
   {
    "t0": 1.5,
    "t1": 4.35,
    "text": "我们不数第几层了。"
   },
   {
    "t0": 4.65,
    "t1": 8.1,
    "text": "画一个随便多大的正方形，"
   },
   {
    "t0": 8.4,
    "t1": 11.24,
    "text": "每条边上有n个点。",
    "say": "每条边上有 n 个点。"
   },
   {
    "t0": 11.54,
    "t1": 16.23,
    "text": "n是几都行：0、1、2、100……",
    "say": "n 是几都行：零、一、二、一百……"
   },
   {
    "t0": 16.83,
    "t1": 21.08,
    "text": "外面包一层，变成大一号的正方形："
   },
   {
    "t0": 21.38,
    "t1": 24.46,
    "text": "右边加一列，n个；",
    "say": "右边加一列，n 个；"
   },
   {
    "t0": 24.76,
    "t1": 27.99,
    "text": "上边加一行，也是n个；",
    "say": "上边加一行，也是 n 个；"
   },
   {
    "t0": 28.29,
    "t1": 30.97,
    "text": "角上，再加1个。",
    "say": "角上，再加一个。"
   },
   {
    "t0": 31.47,
    "t1": 35.32,
    "text": "大正方形减掉原来的正方形，"
   },
   {
    "t0": 35.52,
    "t1": 39.54,
    "text": "剩下的就是这一圈：n加n加1。",
    "say": "剩下的就是这一圈：n 加 n 加一。"
   },
   {
    "t0": 40.04,
    "t1": 44.19,
    "text": "两个n两两配对，多出的1落了单：",
    "say": "两个 n 两两配对，多出的一落了单："
   },
   {
    "t0": 44.39,
    "t1": 47.84,
    "text": "总剩一个的数，就是奇数。"
   },
   {
    "t0": 48.34,
    "t1": 52.31,
    "text": "这样算，不管n是几，都一样。",
    "say": "这样算，不管 n 是几，都一样。"
   },
   {
    "t0": 53.01,
    "t1": 55.26,
    "text": "“那反过来呢？”",
    "voice": "qm",
    "say": "那反过来呢？"
   },
   {
    "t0": 55.56,
    "t1": 60.41,
    "text": "“随便给一个奇数，都能做成这样的一圈吗？”",
    "voice": "qm",
    "say": "随便给一个奇数，都能做成这样的一圈吗？"
   },
   {
    "t0": 60.91,
    "t1": 63.2,
    "text": "比如99。",
    "say": "比如九十九。"
   },
   {
    "t0": 63.5,
    "t1": 67.35,
    "text": "先拿出落单的1个，放在角上，",
    "say": "先拿出落单的一个，放在角上，"
   },
   {
    "t0": 67.65,
    "t1": 72.9,
    "text": "剩下98个，分成两条胳膊，每条49个。",
    "say": "剩下九十八个，分成两条胳膊，每条四十九个。"
   },
   {
    "t0": 73.3,
    "t1": 77.15,
    "text": "包住49×49的正方形，",
    "say": "包住四十九乘四十九的正方形，"
   },
   {
    "t0": 77.35,
    "t1": 80.4,
    "text": "正好变成50×50。",
    "say": "正好变成五十乘五十。"
   },
   {
    "t0": 81.0,
    "t1": 86.7,
    "text": "核对一下：2500减2401，正好99。",
    "say": "核对一下：两千五百减两千四百零一，正好九十九。"
   },
   {
    "t0": 87.6,
    "t1": 92.05,
    "text": "任何奇数都能这样：拿掉落单的1个，",
    "say": "任何奇数都能这样：拿掉落单的一个，"
   },
   {
    "t0": 92.25,
    "t1": 97.1,
    "text": "剩下的两两配对，分成两条一样长的胳膊，"
   },
   {
    "t0": 97.3,
    "t1": 101.35,
    "text": "包住一个正方形，补成大一号的。"
   },
   {
    "t0": 102.05,
    "t1": 106.3,
    "text": "就连1也行：1的平方减0的平方。",
    "say": "就连一也行：一的平方减零的平方。"
   },
   {
    "t0": 107.0,
    "t1": 112.72,
    "text": "所以，1、3、5、7……每一个正奇数，",
    "say": "所以，一、三、五、七……每一个正奇数，"
   },
   {
    "t0": 112.92,
    "t1": 115.77,
    "text": "都是两个平方的差。"
   },
   {
    "t0": 116.37,
    "t1": 120.22,
    "text": "不是试出来的几个，是每一个。"
   }
  ],
  "dur": 120.7
 },
 "evens": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.62,
    "text": "奇数解决了。偶数呢？"
   },
   {
    "t0": 4.12,
    "t1": 7.6,
    "text": "“2找不到，6也找不到……”",
    "voice": "kid",
    "say": "二找不到，六也找不到……"
   },
   {
