 "open": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.35,
    "text": "陶哲轩的故事讲完了。"
   },
   {
    "t0": 3.75,
    "t1": 7.6,
    "text": "那个爱问“为什么”的小问号，"
   },
   {
    "t0": 7.7,
    "t1": 11.15,
    "text": "跳到了Jasper的练习本上。"
   },
   {
    "t0": 11.85,
    "t1": 14.9,
    "text": "Jasper每天都在算题。"
   },
   {
    "t0": 15.3,
    "t1": 17.95,
    "text": "“算对了，然后呢？”",
    "voice": "qm",
    "say": "算对了，然后呢？"
   },
   {
    "t0": 18.35,
    "t1": 22.0,
    "text": "然后，就可以开始问问题了。"
   },
   {
    "t0": 22.9,
    "t1": 27.55,
    "text": "研究整数的这些问题，有个名字：数论。"
   },
   {
    "t0": 27.65,
    "t1": 30.7,
    "text": "它像一张很大的地图。"
   },
   {
    "t0": 31.2,
    "t1": 33.85,
    "text": "地图上有两扇门："
   },
   {
    "t0": 34.15,
    "t1": 37.4,
    "text": "一扇看一个数是谁乘谁，"
   },
   {
    "t0": 37.7,
    "t1": 41.35,
    "text": "一扇看分组以后，还剩几个。"
   },
   {
    "t0": 42.05,
    "t1": 45.7,
    "text": "门后是一级比一级难的问题。"
   },
   {
    "t0": 46.2,
    "t1": 50.05,
    "text": "远处还有雾。我们先走第一步。"
   }
  ],
  "dur": 50.5
 },
 "six": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.35,
    "text": "Jasper的本子上写着："
   },
   {
    "t0": 3.55,
    "t1": 6.2,
    "text": "16减9等于7。",
    "say": "十六减九等于七。"
   },
   {
    "t0": 6.6,
    "t1": 10.25,
    "text": "16是4乘4，9是3乘3。",
    "say": "十六是四乘四，九是三乘三。"
   },
   {
    "t0": 10.65,
    "t1": 14.3,
    "text": "4乘4，可以写成4的平方。",
    "say": "四乘四，可以写成四的平方。"
   },
   {
    "t0": 14.8,
    "t1": 19.45,
    "text": "4×4的点阵，拿掉3×3，剩下7个。",
    "say": "四乘四的点阵，拿掉三乘三，剩下七个。"
   },
   {
    "t0": 19.85,
    "t1": 23.3,
    "text": "所以，7是两个平方的差。",
    "say": "所以，七是两个平方的差。"
   },
   {
    "t0": 24.0,
    "t1": 27.67,
    "text": "“我给它画个小拐角，当记号。”",
    "voice": "kid",
    "say": "我给它画个小拐角，当记号。"
   },
   {
    "t0": 28.17,
    "t1": 32.42,
    "text": "“小拐角是什么意思？别人看得懂吗？”",
    "voice": "qm",
    "say": "小拐角是什么意思？别人看得懂吗？"
   },
   {
    "t0": 32.82,
    "t1": 37.44,
    "text": "“意思是：能写成一个平方减另一个平方。”",
    "voice": "kid",
    "say": "意思是：能写成一个平方减另一个平方。"
   },
   {
    "t0": 37.84,
    "t1": 40.49,
    "text": "“0的平方算不算？”",
    "voice": "qm",
    "say": "零的平方算不算？"
   },
   {
    "t0": 40.99,
    "t1": 44.24,
    "text": "好问题。规则得写清楚："
   },
   {
    "t0": 44.54,
    "t1": 47.79,
    "text": "两个数都是0或正整数，",
    "say": "两个数都是零或正整数，"
   },
   {
    "t0": 47.99,
    "t1": 52.44,
    "text": "前一个比后一个大，后一个可以是0。",
    "say": "前一个比后一个大，后一个可以是零。"
   },
   {
    "t0": 52.64,
    "t1": 55.29,
    "text": "负数，以后再说。"
   },
   {
    "t0": 55.69,
    "t1": 59.34,
    "text": "写清楚了，别人才能照着用。"
   },
   {
    "t0": 60.24,
    "t1": 62.09,
    "text": "那6呢？",
    "say": "那六呢？"
   },
   {
    "t0": 62.49,
    "t1": 65.59,
    "text": "“9减3？3不是平方。”",
    "voice": "kid",
    "say": "九减三？三不是平方。"
   },
   {
    "t0": 65.99,
    "t1": 69.09,
    "text": "“16减10？10也不是。”",
    "voice": "kid",
    "say": "十六减十？十也不是。"
   },
   {
    "t0": 69.49,
    "t1": 72.21,
    "text": "“25减19……”",
    "voice": "kid",
    "say": "二十五减十九……"
   },
   {
    "t0": 72.81,
    "t1": 76.46,
    "text": "找了半天，6还没有小拐角。",
    "say": "找了半天，六还没有小拐角。"
   },
   {
    "t0": 76.96,
    "t1": 80.61,
    "text": "“是还没找到，还是根本没有？”",
    "voice": "qm",
    "say": "是还没找到，还是根本没有？"
   },
   {
    "t0": 81.11,
    "t1": 84.56,
    "text": "这是两件完全不一样的事。"
   }
  ],
  "dur": 85.1
 },
 "bands": {
