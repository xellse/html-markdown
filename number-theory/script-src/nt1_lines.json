    "t1": 34.01,
    "text": "可是，我们只看了三层。"
   },
   {
    "t0": 34.41,
    "t1": 37.66,
    "text": "“第一百层，也是奇数吗？”",
    "voice": "qm",
    "say": "第一百层，也是奇数吗？"
   }
  ],
  "dur": 38.2
 },
 "proof": {
  "subs": [
   {
