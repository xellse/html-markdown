 "open": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.35,
    "text": "陶哲轩的故事讲完了。"
   },
   {
    "t0": 3.75,
    "t1": 7.6,
    "text": "那个爱问“为什么”的小问号，"
   },
   {
    "t0": 7.7,
    "t1": 11.15,
    "text": "跳到了Jasper的练习本上。"
   },
   {
    "t0": 11.85,
    "t1": 14.9,
    "text": "Jasper每天都在算题。"
   },
   {
    "t0": 15.3,
    "t1": 17.95,
    "text": "“算对了，然后呢？”",
    "voice": "qm",
    "say": "算对了，然后呢？"
   },
   {
    "t0": 18.35,
    "t1": 22.0,
    "text": "然后，就可以开始问问题了。"
   },
   {
    "t0": 22.9,
    "t1": 27.75,
    "text": "整数的这些问题，叫数论，像一张大地图。"
   },
   {
    "t0": 28.25,
    "t1": 30.9,
    "text": "地图上有两扇门："
   },
   {
    "t0": 31.2,
    "t1": 34.45,
    "text": "一扇看一个数是谁乘谁，"
   },
   {
    "t0": 34.75,
    "t1": 38.4,
    "text": "一扇看分组以后，还剩几个。"
   },
   {
    "t0": 39.1,
    "t1": 43.55,
    "text": "两扇门中间，是一级比一级难的问题："
   },
   {
    "t0": 43.85,
    "t1": 47.5,
    "text": "“有没有？怎么造？找得全吗？”",
    "voice": "qm",
    "say": "有没有？怎么造？找得全吗？"
   },
   {
    "t0": 47.7,
    "t1": 51.55,
    "text": "“为什么不可能？有无穷多个吗？”",
    "voice": "qm",
    "say": "为什么不可能？有无穷多个吗？"
   },
   {
    "t0": 52.15,
    "t1": 55.6,
    "text": "远处有雾。我们只问整数，"
   },
   {
    "t0": 55.8,
    "t1": 59.65,
    "text": "可整数会逼我们去找更大的家。"
   },
   {
    "t0": 59.95,
    "t1": 62.2,
    "text": "先走第一步。"
   }
  ],
  "dur": 62.7
 },
 "six": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 3.35,
    "text": "Jasper的本子上写着："
   },
   {
    "t0": 3.55,
    "t1": 6.2,
    "text": "16减9等于7。",
    "say": "十六减九等于七。"
   },
   {
    "t0": 6.6,
    "t1": 10.25,
    "text": "16是4乘4，9是3乘3。",
    "say": "十六是四乘四，九是三乘三。"
   },
   {
    "t0": 10.65,
    "t1": 14.3,
    "text": "4乘4，可以写成4的平方。",
    "say": "四乘四，可以写成四的平方。"
   },
   {
    "t0": 15.0,
    "t1": 19.65,
    "text": "4×4的点阵，拿掉3×3，剩下7个。",
    "say": "四乘四的点阵，拿掉三乘三，剩下七个。"
   },
   {
    "t0": 20.15,
    "t1": 23.6,
    "text": "所以，7是两个平方的差。",
    "say": "所以，七是两个平方的差。"
   },
   {
    "t0": 24.3,
    "t1": 27.97,
    "text": "“我给它画个小拐角，当记号。”",
    "voice": "kid",
    "say": "我给它画个小拐角，当记号。"
   },
   {
    "t0": 28.47,
    "t1": 32.72,
    "text": "“小拐角是什么意思？别人看得懂吗？”",
    "voice": "qm",
    "say": "小拐角是什么意思？别人看得懂吗？"
   },
   {
    "t0": 33.12,
    "t1": 37.74,
    "text": "“意思是：能写成一个平方减另一个平方。”",
    "voice": "kid",
    "say": "意思是：能写成一个平方减另一个平方。"
   },
   {
    "t0": 38.14,
    "t1": 40.79,
    "text": "“0的平方算不算？”",
    "voice": "qm",
    "say": "零的平方算不算？"
   },
   {
    "t0": 41.29,
    "t1": 44.54,
    "text": "好问题。规则得写清楚："
   },
   {
    "t0": 44.84,
    "t1": 49.49,
    "text": "两个数，都从0、1、2、3……里挑，",
    "say": "两个数，都从零、一、二、三……里挑，"
   },
   {
    "t0": 49.69,
    "t1": 54.14,
    "text": "前一个比后一个大，后一个可以是0。",
    "say": "前一个比后一个大，后一个可以是零。"
   },
   {
    "t0": 54.34,
    "t1": 57.79,
    "text": "比0还小的数，以后再说。",
    "say": "比零还小的数，以后再说。"
   },
   {
    "t0": 58.19,
    "t1": 61.84,
    "text": "写清楚了，别人才能照着用。"
   },
   {
    "t0": 62.74,
    "t1": 64.59,
    "text": "那6呢？",
    "say": "那六呢？"
   },
   {
    "t0": 64.99,
    "t1": 68.09,
    "text": "“9减3？3不是平方。”",
    "voice": "kid",
    "say": "九减三？三不是平方。"
   },
   {
    "t0": 68.49,
    "t1": 71.59,
    "text": "“16减10？10也不是。”",
    "voice": "kid",
    "say": "十六减十？十也不是。"
   },
   {
    "t0": 71.99,
    "t1": 74.71,
    "text": "“25减19……”",
    "voice": "kid",
    "say": "二十五减十九……"
   },
   {
    "t0": 75.31,
    "t1": 78.96,
    "text": "找了半天，6还没有小拐角。",
    "say": "找了半天，六还没有小拐角。"
   },
   {
    "t0": 79.46,
    "t1": 83.11,
    "text": "“是还没找到，还是根本没有？”",
    "voice": "qm",
    "say": "是还没找到，还是根本没有？"
   }
  ],
  "dur": 83.6
 },
 "bands": {
  "subs": [
   {
    "t0": 0.3,
    "t1": 4.15,
    "text": "先别急着找6，看看能找到谁。",
